# Manim renderer: python bytecode, probe scripts and their rendered scratch output.
# Only render_beat.py / render_worker.py / scenes.py / requirements.txt / example_beat.json
# are real source; everything else under scripts/manim is generated while testing a render.
frontend/web/scripts/manim/__pycache__/
frontend/web/scripts/manim/_probe.py
frontend/web/scripts/manim/_mk.py
frontend/web/scripts/manim/_probe_media/
frontend/web/scripts/manim/_specs/
frontend/web/scripts/manim/_test_script.json

# Dev-server logs written by the local runner
frontend/web/.codex-dev.*.log

# Downloaded + expanded Bioicons source (frontend/web/scripts/build-asset-catalogue.mjs).
# The generated frontend/web/assets/ directory IS committed — it is the artwork the sandbox
# places, and rebuilding it depends on an upstream repo that can change under you.
frontend/web/.asset-build/
