.test-build/

# Manim renderer: venv, pip scratch, and rendered-beat cache
frontend/web/scripts/manim/.venv/
frontend/web/scripts/manim/.pip-tmp/
frontend/web/scripts/manim/.pip-cache/
frontend/web/scripts/manim/_smoke_media/
frontend/web/scripts/manim/_out/
frontend/web/scripts/manim/_frames/
frontend/web/scripts/manim/_smoke.py
frontend/web/.manim-cache/

# Manim renderer: python bytecode, probe scripts and their rendered scratch output.
# Only render_beat.py / render_worker.py / scenes.py / requirements.txt / example_beat.json
# are real source; everything else under scripts/manim is generated while testing a render.
frontend/web/scripts/manim/__pycache__/
frontend/web/scripts/manim/_probe.py
frontend/web/scripts/manim/_mk.py
frontend/web/scripts/manim/_probe_media/
frontend/web/scripts/manim/_specs/
frontend/web/scripts/manim/_test_script.json

# Dev-server logs written by the local runner
frontend/web/.codex-dev.*.log

# Downloaded + expanded Bioicons source (frontend/web/scripts/build-asset-catalogue.mjs).
# The generated frontend/web/assets/ directory IS committed — it is the artwork the sandbox
# places, and rebuilding it depends on an upstream repo that can change under you.
frontend/web/.asset-build/

# pdfjs-dist's worker script, copied into public/ at dev/build time by
# scripts/copy-pdf-worker.mjs — always sourced from the installed package version so it can
# never drift from the pdfjs-dist build the client bundle actually loads.
frontend/web/public/pdf.worker.min.mjs

# Local database + auth secrets — never committed.
frontend/web/drizzle/

# Unrelated scratch/sibling projects that live inside this repo checkout but are not part of it —
# each has its own separate history (direct-booking-rental has its own .git) or is a throwaway
# prototype (unity-campus-poc, gemini-live-test-app). `git add -A` has pulled these in as an
# embedded gitlink / thousands of stray files more than once; ignoring them here is the fix.
/direct-booking-rental/
/gemini-live-test-app/
/unity-campus-poc/
