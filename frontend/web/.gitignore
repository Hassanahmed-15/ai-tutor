# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
!.env.example

# vercel
.vercel

# generated lesson cache (see lib/lectureCache.ts)
/.lecture-cache/

# animation model comparison log (see lib/animationTrials.ts)
/.animation-trials/

# typescript
*.tsbuildinfo
next-env.d.ts

# Screenshot artifacts from the board verifiers (scripts/verify-*.mjs)
/board_*.png
/plot_*.png

# Python bytecode from scripts/pdf_pipeline.py
__pycache__/

# Slide-bench run log (local measurements, regenerated by running the bench)
.slidebench/

# Bench screenshots (regenerated by scripts/shoot-slide-bench.mjs)
bench-screenshots/
slide-model-comparison.docx
