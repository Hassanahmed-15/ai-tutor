# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# generated lesson cache (see lib/lectureCache.ts)
/.lecture-cache/

# generated game backdrops (see app/api/game-art) — a per-topic cache, regenerable,
# and binary; committing one blob per lesson anyone plays is not a repo.
/public/generated/game-bg-*.png

# typescript
*.tsbuildinfo
next-env.d.ts
