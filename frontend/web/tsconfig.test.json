{
  "//": "Test-only build. The app targets a bundler (extensionless ESM imports), which Node's ESM loader cannot resolve, so tests compile to CommonJS in .test-build and run there via `node --test`. Run with `npm run test:anim`.",
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "module": "commonjs",
    "moduleResolution": "node",
    "target": "ES2022",
    "outDir": ".test-build",
    "noEmit": false,
    "incremental": false,
    "types": ["node"],
    "paths": {
      "@/*": ["./*"],
      "vega-lite": ["../../node_modules/vega-lite/build/index.d.ts"]
    }
  },
  "include": [
    "lib/anim/**/*.ts",
    "lib/animationRouting.ts",
    "lib/manimRouting.ts",
    "lib/manimSceneSpec.ts",
    "lib/structureSpec.ts",
    "lib/structureLayout.ts",
    "lib/jsxRepair.ts",
    "lib/assetCatalogue.ts",
    "lib/equationSpec.ts",
    "lib/plotSpec.ts",
    "lib/director.ts",
    "lib/beatVisualSpec.ts",
    "lib/boardFallback.ts",
    "components/hud/tracks.ts",
    "lib/adhd/gate.ts",
    "lib/suprnotes.ts",
    "lib/pdfLessonPipeline.ts",
    "lib/reactAnimationVisionCritic.ts",
    "lib/manimCacheKey.ts",
    "components/sketch/LiveSketch.tsx",
    "components/whiteboard/sketch.ts"
  ],
  "exclude": ["node_modules"]
}
