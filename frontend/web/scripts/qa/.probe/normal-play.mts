import { readFileSync } from "node:fs";
import { SignJWT } from "jose";
import { chromium } from "playwright";
const env = Object.fromEntries(readFileSync("/Users/hassanahmed/ai-tutor/frontend/web/.env.local", "utf8").split("\n").filter((l) => /^[A-Z_]+=/.test(l)).map((l) => [l.slice(0, l.indexOf("=")), l.slice(l.indexOf("=") + 1).replace(/^["']|["']$/g, "")]));
const token = await new SignJWT({}).setProtectedHeader({ alg: "HS256" }).setSubject("local-dev-canvas").setIssuedAt().setExpirationTime("1h").sign(new TextEncoder().encode(env.AUTH_SECRET));
const browser = await chromium.launch({ args: ["--autoplay-policy=no-user-gesture-required"] });
const ctx = await browser.newContext({ viewport: { width: 1440, height: 860 } });
await ctx.addCookies([{ name: "aria_access", value: token, domain: "localhost", path: "/" }]);
const page = await ctx.newPage();
await page.addInitScript("window.__name = f => f");
const errs: string[] = []; page.on("pageerror", (e) => errs.push(e.message)); page.on("console", (m) => { if (m.type() === "error") errs.push(m.text().slice(0, 200)); });
await page.goto(`http://localhost:3000/canvas-lab?session=${process.argv[2]}&voice=0`, { waitUntil: "load", timeout: 120000 });
await page.waitForTimeout(12000);
await page.screenshot({ path: process.env.HOME + "/aria-qa-images/2026-11-08-pythagoras-lab/normal-0.png" });
const buttons = await page.evaluate(() => [...document.querySelectorAll("button")].map((b) => b.textContent?.trim()).filter(Boolean).slice(0, 30));
console.log("buttons:", buttons);
console.log("lab marks:", await page.evaluate(() => document.querySelectorAll("[data-lab]").length), "svg panels:", await page.evaluate(() => document.querySelectorAll("[data-mark]").length));
console.log("errors:", errs.slice(0, 8));
await browser.close();
