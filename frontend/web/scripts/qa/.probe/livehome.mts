import { writeFileSync } from "node:fs";
import { chromium } from "playwright";
import { SignJWT } from "jose";
const owner = "c82ec597-f14f-4849-a512-6549f14d5919";
const H = "https://aria-tutor.jollyfield-0fda1d9b.westus2.azurecontainerapps.io";
const out: string[] = [];
const token = await new SignJWT({ email: `${owner}@example.com` }).setProtectedHeader({ alg: "HS256" }).setSubject(owner).setIssuedAt().setExpirationTime("1h").sign(new TextEncoder().encode(process.env.LIVE_AUTH_SECRET!));
const b = await chromium.launch();
const ctx = await b.newContext({ viewport: { width: 1440, height: 900 } });
await ctx.addCookies([{ name: "aria_access", value: token, domain: new URL(H).hostname, path: "/", secure: true, httpOnly: true, sameSite: "Lax" }]);
const page = await ctx.newPage();
const t0 = Date.now();
const t = () => `${((Date.now() - t0) / 1000).toFixed(1)}s`;
page.on("response", (r) => out.push(`${t()} ${r.status()} ${r.url().replace(H, "").slice(0, 90)}`));
page.on("requestfailed", (r) => out.push(`${t()} FAILED ${r.url().replace(H, "").slice(0, 90)} ${r.failure()?.errorText}`));
page.on("console", (m) => { if (m.type() === "error" || m.type() === "warning") out.push(`${t()} console.${m.type()}: ${m.text().slice(0, 220)}`); });
page.on("pageerror", (e) => out.push(`${t()} PAGE ERROR: ${e.message.slice(0, 220)}`));
await page.goto(H, { waitUntil: "domcontentloaded", timeout: 120000 });
await page.waitForFunction(() => !document.body.innerText.includes("Starting Aria"), null, { timeout: 45000 }).catch(() => out.push("still starting after 45 s"));
await page.waitForTimeout(3000);
const buttons = await page.$$eval("button, a", (els) => els.map((e) => (e.textContent ?? "").trim().replace(/\s+/g, " ")).filter((t) => t && t.length < 60));
out.push("buttons: " + [...new Set(buttons)].slice(0, 50).join(" | "));
await page.screenshot({ path: `${process.env.HOME}/aria-qa-images/livehome.png` });
writeFileSync("/private/tmp/claude-501/-Users-hassanahmed-ai-tutor/2735a389-20f1-4b4d-94c6-1e1ea98cc81e/scratchpad/livehome.txt", out.join("\n"));
await b.close();
process.exit(0);
