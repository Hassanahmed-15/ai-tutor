# Existing app secrets (use Azure secret references in production; never commit real values)
OPENAI_API_KEY=
COSMOS_CONNECTION_STRING=
AZURE_STORAGE_CONNECTION_STRING=
AZURE_STORAGE_CONTAINER=lecture-videos

# Progressive lecture queue and worker. Azure Queue Storage uses the same connection string as
# Blob storage, so production needs only this queue name plus the separate worker container.
AZURE_STORAGE_QUEUE=progressive-lecture-generation
PROGRESSIVE_QUEUE_TRANSPORT=storage
PROGRESSIVE_WORKER_CONCURRENCY=4
OPENAI_PROGRESSIVE_MODEL=gpt-4o-mini
OPENAI_PROFILE_MODEL=gpt-4o-mini

# Local development uses the bounded in-process worker unless a transport is explicitly selected.
PROGRESSIVE_IN_PROCESS_WORKER=0

# Premium visual enrichment. The playable SVG fallback is retained when one is disabled/fails.
REACT_ANIMATIONS_ENABLED=1
BLACKBOARD_GEN_ENABLED=1
MANIM_RENDER_ENABLED=0

# ---------------------------------------------------------------------------
# PDF pipeline
# ---------------------------------------------------------------------------
# Python interpreter with PyMuPDF/OpenCV/pytesseract (scripts/requirements-pdf.txt).
# WITHOUT THIS the app falls back to bare `python3`, which on most machines lacks those
# packages — page previews then fail, and the two code paths report it differently (one
# degrades to "previews unavailable", the other returns a raw spawn error).
#   python3 -m venv .venv-pdf && .venv-pdf/bin/pip install -r scripts/requirements-pdf.txt
PDF_PYTHON_BINARY=.venv-pdf/bin/python3

# Figure detection runs one vision call per page that actually contains artwork (pages that are
# pure text are skipped outright — see lib/figureDetectionScope.ts). The page cap is 20, so 10
# drains any legal upload in two waves. Dial DOWN if the account starts seeing 429s; the real
# ceiling is OpenAI's rate limit, which varies by tier.
PDF_PAGE_CONCURRENCY=10

# How long a board may spend in the refine loop while the student is still waiting for playback
# to start. Later beats are built behind a beat that is already playing and keep the full budget
# (REACT_REFINE_TIME_BUDGET_MS, default 45000).
PROGRESSIVE_STARTER_REFINE_BUDGET_MS=20000

# Gemini Live model for the voice tutor. gemini-3.8-live is the newest general Live model; the
# extended-thinking variant adds per-turn reasoning latency, wrong for full-duplex conversation.
# GEMINI_LIVE_MODEL=gemini-3.8-live

# ---------------------------------------------------------------------------
# Social sign-in (docs/social-sign-in.md)
# ---------------------------------------------------------------------------
# Each provider's button works as soon as its keys are set; without them it tells the student to
# use email instead. Redirect URI to register with each provider:
#   {APP_URL}/api/auth/oauth/{google|microsoft|apple}/callback
# The public origin of the app. Behind Azure Container Apps the forwarded host is used if unset,
# but set it explicitly in production so the redirect URI always matches what was registered.
# APP_URL=https://aria-tutor.jollyfield-0fda1d9b.westus2.azurecontainerapps.io
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=
# MICROSOFT_CLIENT_ID=
# MICROSOFT_CLIENT_SECRET=
# "common" = personal + work/school accounts; or a tenant id to restrict to one organisation.
# MICROSOFT_TENANT_ID=common
# Services ID (e.g. com.example.aria.web), Team ID, and the Sign in with Apple key (.p8) with
# its newlines written as \n.
# APPLE_CLIENT_ID=
# APPLE_TEAM_ID=
# APPLE_KEY_ID=
# APPLE_PRIVATE_KEY=

# Onboarding: AI suggestions when the curated subject/level/curriculum list has no match, and the
# homepage's "Suggested for you" lesson tiles. Both default to gpt-5.6-luna.
# OPENAI_EDUCATION_SUGGEST_MODEL=gpt-5.6-luna
# OPENAI_PROMPT_TILES_MODEL=gpt-5.6-luna
