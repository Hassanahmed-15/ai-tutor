         "outcomes": [
          {
           "code": null,
           "text": "Conjugate weak and strong verbs in the present tense, including for future and ongoing meaning."
          },
          {
           "code": null,
           "text": "Use irregular haben, sein, werden and wissen, and haben + noun phrases like Hunger haben."
