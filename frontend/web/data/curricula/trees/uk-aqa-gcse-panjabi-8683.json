     "id": "3-4-communication-strategies",
     "title": "3.4 Communication strategies",
     "topics": [
      {
       "id": "3-4-strategies-for-understanding",
       "title": "3.4 Strategies for understanding",
       "subtopics": [
        {
         "id": "ignoring-unneeded-words",
         "title": "Ignoring unneeded words",
         "outcomes": [
          {
           "code": "3.4.1",
           "text": "Skip non-essential words, since key points are often repeated in different ways."
          }
         ]
        },
        {
         "id": "using-context",
         "title": "Using context",
         "outcomes": [
          {
           "code": "3.4.2",
           "text": "Use layout, title, pictures and surrounding words to infer new word meaning."
          }
         ]
        },
        {
         "id": "grammatical-markers",
         "title": "Grammatical markers",
         "outcomes": [
          {
           "code": "3.4.3",
           "text": "Use plurals, verb endings and word order to identify an unknown word's category."
          }
         ]
        },
        {
         "id": "social-and-cultural-context",
         "title": "Social and cultural context",
         "outcomes": [
          {
           "code": "3.4.4",
           "text": "Use real-world and cultural knowledge, such as respectful plurals, to predict meaning."
          }
         ]
        },
        {
         "id": "word-formation-patterns",
         "title": "Word-formation patterns",
         "outcomes": [
          {
           "code": "3.4.5",
           "text": "Use common word-formation patterns and inflections in both directions."
          }
         ]
        },
        {
         "id": "reading-strategies",
         "title": "Reading strategies",
         "outcomes": [
          {
           "code": "3.4.6",
           "text": "Recognise English loanwords in Panjabi and tricky look-alike letters and sounds."
          }
         ]
        },
        {
         "id": "listening-strategies",
         "title": "Listening strategies",
         "outcomes": [
          {
           "code": "3.4.7",
           "text": "Notice similar-sounding words and apply the reading strategies to listening."
          }
         ]
        }
       ]
      },
      {
       "id": "3-4-strategies-for-production",
       "title": "3.4 Strategies for production",
       "subtopics": [
        {
         "id": "production-strategies-overview",
         "title": "Production strategies overview",
         "outcomes": [
          {
           "code": "3.4.8",
           "text": "Use systematic verbal and non-verbal strategies to get meaning across."
          }
         ]
        },
        {
         "id": "non-verbal-strategies",
         "title": "Non-verbal strategies",
         "outcomes": [
          {
           "code": "3.4.9",
           "text": "Use non-verbal strategies when communication breaks down."
          },
          {
           "code": "3.4.9.1",
           "text": "Point and demonstrate with simple accompanying words."
          },
          {
           "code": "3.4.9.2",
           "text": "Use expression, gesture and exclamations to show feeling."
          },
          {
           "code": "3.4.9.3",
           "text": "Use mime, noting its limits in recorded speaking tests."
          },
          {
           "code": "3.4.9.4",
           "text": "Use drawing or diagrams to convey information in written tasks."
          }
         ]
        },
        {
         "id": "verbal-strategies",
         "title": "Verbal strategies",
         "outcomes": [
          {
           "code": "3.4.10",
           "text": "Use verbal strategies to get round forgotten words."
          },
          {
           "code": "3.4.10.1",
           "text": "Use a word for a similar item when the exact word is forgotten."
          },
          {
           "code": "3.4.10.2",
           "text": "Describe an item's colour, size, material, position or shape."
          },
          {
           "code": "3.4.10.3",
           "text": "Ask for help, translation or spelling in Panjabi."
          },
          {
           "code": "3.4.10.4",
           "text": "Simplify a structure you are unsure of by using an easier one."
          },
          {
           "code": "3.4.10.5",
           "text": "Paraphrase to avoid a forgotten word."
          },
          {
           "code": "3.4.10.6",
           "text": "Refer to specific features to identify a person or thing."
          },
          {
           "code": "3.4.10.7",
           "text": "Describe an object by its function and what it does."
          }
         ]
        }
       ]
      }
     ]
