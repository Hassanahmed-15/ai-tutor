     "id": "3-3-grammar",
     "title": "3.3 Grammar",
     "topics": [
      {
       "id": "3-3-1-foundation-tier",
       "title": "3.3.1 Foundation Tier",
       "subtopics": [
        {
         "id": "nouns-and-gender",
         "title": "Nouns and gender",
         "outcomes": [
          {
           "code": "3.3.1.1",
           "text": "Use noun gender, single and plural forms, and direct and oblique cases."
          },
          {
           "code": "3.3.1.2",
           "text": "Apply gender and case forms correctly to nouns."
          }
         ]
        },
        {
         "id": "adjectives",
         "title": "Adjectives",
         "outcomes": [
          {
           "code": "3.3.1.3",
           "text": "Use inflecting and invariable adjectives, attributive and predicative use."
          },
          {
           "code": null,
           "text": "Use demonstratives this and that, indefinite some, and possessive adjectives including own."
          },
          {
           "code": null,
           "text": "Use interrogative adjectives such as which and whose."
          }
         ]
        },
        {
         "id": "adverbs-and-particles",
         "title": "Adverbs and particles",
         "outcomes": [
          {
           "code": "3.3.1.4",
           "text": "Use interrogative adverbs and adverbs of time and place."
          },
          {
           "code": null,
           "text": "Recognise relative-correlative pairs and use common adverbial phrases."
          },
          {
           "code": null,
           "text": "Use the particles also and only; recognise the particle then."
          }
         ]
        },
        {
         "id": "verb-forms-personal-and-imperative",
         "title": "Verb forms: personal and imperative",
         "outcomes": [
          {
           "code": "3.3.1.5",
           "text": "Form personal verb forms, the subjunctive and ordinary imperative; recognise polite imperative."
          }
         ]
        },
        {
         "id": "verb-forms-participles",
         "title": "Verb forms: participles",
         "outcomes": [
          {
           "code": null,
           "text": "Use imperfect, perfect and potential participles."
          }
         ]
        },
        {
         "id": "verb-forms-future-and-nominal",
         "title": "Verb forms: future and nominal",
         "outcomes": [
          {
           "code": null,
           "text": "Form the future with subjunctive plus the future marker; use the gerund and the conjunctive participle."
          }
         ]
        },
        {
         "id": "auxiliaries-and-tenses",
         "title": "Auxiliaries and tenses",
         "outcomes": [
          {
           "code": null,
           "text": "Use tense forms of to be and auxiliary verbs such as give, take, can, finish, become, stay."
          }
         ]
        },
        {
         "id": "causatives-and-serial-verbs",
         "title": "Causatives and serial verbs",
         "outcomes": [
          {
           "code": null,
           "text": "Form causative verbs and simple serial verb constructions like was going."
          }
         ]
        },
        {
         "id": "passive-and-agreement",
         "title": "Passive and agreement",
         "outcomes": [
          {
           "code": null,
           "text": "Form simple passives with perfect participle plus go; apply verb agreement with subject, object or neither."
          }
         ]
        },
        {
         "id": "verb-forms-as-adjectives",
         "title": "Verb forms as adjectives",
         "outcomes": [
          {
           "code": null,
           "text": "Recognise verb adjectival forms used as adjectives and imperfect forms with the ending ee."
          }
         ]
        },
        {
         "id": "postpositions",
         "title": "Postpositions",
         "outcomes": [
          {
           "code": "3.3.1.6",
           "text": "Use simple, adverb-derived, compound and emphatic postpositions, and the forms of of and wala."
          }
         ]
        },
        {
         "id": "conjunctions-and-numbers",
         "title": "Conjunctions and numbers",
         "outcomes": [
          {
           "code": null,
           "text": "Use coordinating conjunctions and subordinators like because and when."
          },
          {
           "code": null,
           "text": "Use cardinal and ordinal numbers, quantity, dates, time and fractional numbers."
          }
         ]
        }
       ]
      },
      {
       "id": "3-3-2-higher-tier",
       "title": "3.3.2 Higher Tier",
       "subtopics": [
        {
         "id": "particles",
         "title": "Particles",
         "outcomes": [
          {
           "code": "3.3.2.1",
           "text": "Use the particle then actively."
          }
         ]
        },
        {
         "id": "higher-verb-forms",
         "title": "Higher verb forms",
         "outcomes": [
          {
           "code": "3.3.2.2",
           "text": "Use adjectival verb forms as adjectives, polite imperative and potential participle for commands."
          },
          {
           "code": null,
           "text": "Use the stem-plus-ee imperfect and durative or iterative forms with ee."
          }
         ]
        },
        {
         "id": "higher-auxiliaries-and-conditionals",
         "title": "Higher auxiliaries and conditionals",
         "outcomes": [
          {
           "code": null,
           "text": "Use auxiliary verbs come, go, keep, leave; use imperfect participle for contrary-to-fact situations."
          }
         ]
        },
        {
         "id": "longer-verb-constructions",
         "title": "Longer verb constructions",
         "outcomes": [
          {
           "code": null,
           "text": "Recognise longer serial verbs, perfect-participle-plus-be passives and quasi-verb forms."
          }
         ]
        },
        {
         "id": "complex-sentences",
         "title": "Complex sentences",
         "outcomes": [
          {
           "code": null,
