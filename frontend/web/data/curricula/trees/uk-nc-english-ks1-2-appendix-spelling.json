          },
          {
           "code": null,
           "text": "Add -s and -es to make plurals and third-person verbs."
          },
          {
           "code": null,
           "text": "Add -ing, -ed and -er to verbs with no change to the root word."
          },
          {
           "code": null,
           "text": "Add -er and -est to adjectives with no change to the root word."
          }
