         "outcomes": [
          {
           "code": null,
           "text": "Spell the sounds /f/, /l/, /s/, /z/ and /k/ as ff, ll, ss, zz and ck after a single vowel in short words."
          },
          {
           "code": null,
           "text": "Spell the /ŋ/ sound as n before k, as in bank and think."
          },
          {
           "code": null,
           "text": "Spell the /tʃ/ sound as tch after a single vowel, as in catch."
          },
          {
           "code": null,
           "text": "Spell words ending in the /v/ sound with a final e, as in have and give."
          }
         ]
        }
       ]
