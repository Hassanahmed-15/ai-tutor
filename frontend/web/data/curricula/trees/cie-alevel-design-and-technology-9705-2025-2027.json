       "title": "Content",
       "subtopics": [
        {
         "id": "design-approaches",
         "title": "Design Approaches",
         "outcomes": [
          {
           "code": null,
           "text": "Understand iterative design and intuitive design as different approaches to designing."
          }
         ]
        },
        {
         "id": "design-thinking-stages",
         "title": "Design Thinking Stages",
         "outcomes": [
          {
           "code": null,
           "text": "Research users’ needs during the empathise stage."
          },
          {
           "code": null,
           "text": "Define and clearly state users’ needs and problems."
          },
          {
           "code": null,
           "text": "Challenge assumptions and generate ideas during ideation."
          },
          {
           "code": null,
           "text": "Refine ideas through an iterative development process."
          },
          {
           "code": null,
           "text": "Begin creating solutions during the realisation stage."
          },
          {
           "code": null,
           "text": "Test proposed solutions to assess their effectiveness."
          }
         ]
        },
        {
         "id": "product-function-and-qualities",
         "title": "Product Function And Qualities",
         "outcomes": [
          {
           "code": null,
           "text": "Analyse products according to their function."
          },
          {
           "code": null,
           "text": "Analyse products according to their aesthetic qualities."
          },
          {
           "code": null,
           "text": "Analyse products according to ergonomics."
          },
          {
           "code": null,
           "text": "Analyse the materials used in products and their properties."
          },
          {
           "code": null,
           "text": "Analyse the production processes used to make products."
          },
          {
           "code": null,
           "text": "Analyse products in relation to their target market and customers."
          }
         ]
        },
        {
         "id": "product-cost-safety-and-sustainability",
         "title": "Product Cost Safety And Sustainability",
         "outcomes": [
          {
           "code": null,
           "text": "Analyse product cost."
          },
          {
           "code": null,
           "text": "Analyse how safely products can be used."
          },
          {
           "code": null,
           "text": "Analyse product quality control, including non-toxic paints and electrical safety standards."
          },
          {
           "code": null,
           "text": "Analyse the sustainability of products."
          }
         ]
        },
        {
         "id": "identify-and-research-needs",
         "title": "Identify And Research Needs",
         "outcomes": [
          {
           "code": null,
           "text": "Identify an original design need or an opportunity to improve an existing product."
          },
          {
           "code": null,
           "text": "Prepare a design brief that accurately describes the design need."
          },
          {
           "code": null,
           "text": "Find, gather and analyse information relevant to a design need."
          },
          {
           "code": null,
           "text": "Conduct relevant primary and secondary research using observations, interviews and questionnaires."
          },
          {
           "code": null,
           "text": "Create a concise, justified and measurable design specification."
          }
         ]
        },
        {
         "id": "generate-and-develop-ideas",
         "title": "Generate And Develop Ideas",
         "outcomes": [
          {
           "code": null,
           "text": "Generate and record possible design solutions."
          },
          {
           "code": null,
           "text": "Develop and refine ideas using research, analysis and specification checks."
          },
          {
           "code": null,
           "text": "Evaluate possible solutions using varied techniques and select one for development."
          },
          {
           "code": null,
           "text": "Model ideas and proposals to test appearance and viability."
          },
          {
           "code": null,
           "text": "Develop a detailed design proposal for a product."
          }
         ]
        },
        {
         "id": "plan-product-realisation",
         "title": "Plan Product Realisation",
         "outcomes": [
          {
           "code": null,
           "text": "Identify the resources needed to realise a product."
          },
          {
           "code": null,
           "text": "Organise resources needed to realise a product."
          },
          {
           "code": null,
           "text": "Plan efficient use of materials, energy and other resources when making a product."
          },
          {
           "code": null,
           "text": "Realise a product using suitable tools and equipment."
          },
          {
           "code": null,
           "text": "Apply health and safety procedures in a school workshop or practical area."
          }
         ]
        },
        {
         "id": "test-and-improve-products",
         "title": "Test And Improve Products",
         "outcomes": [
          {
           "code": null,
           "text": "Apply suitable tests to assess whether a product is successful."
          },
          {
           "code": null,
           "text": "Propose further improvements to a product."
          }
         ]
        }
       ]
      }
