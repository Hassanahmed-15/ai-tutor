    {
     "id": "appendix-2-grammar-list-foundation-tier",
     "title": "Appendix 2: Grammar list (Foundation tier)",
     "topics": [
      {
       "id": "nouns-and-measure-words",
       "title": "Nouns and measure words",
       "subtopics": [
        {
         "id": "nouns-and-measure-words",
         "title": "Nouns and measure words",
         "outcomes": [
          {
           "code": null,
           "text": "Use noun suffixes 子, 家, 员."
          },
          {
           "code": null,
           "text": "Use the measure words 个, 岁, 年, 只, 天, 本, 口."
          },
          {
           "code": null,
           "text": "Use 每 to mean every."
          }
         ]
        }
       ]
      },
      {
       "id": "adjectives-and-comparison",
       "title": "Adjectives and comparison",
       "subtopics": [
        {
         "id": "adjectives-and-stative-verbs",
         "title": "Adjectives and stative verbs",
         "outcomes": [
          {
           "code": null,
           "text": "Use adjectives as predicates, with 很 and 非常, and to modify nouns with or without 的."
          },
          {
           "code": null,
           "text": "Use 了 to show a limit passed or a new situation."
          },
          {
           "code": null,
           "text": "Use stative verbs as adverbs and the exclamations 太...了 and 真."
          }
         ]
        },
        {
         "id": "comparatives-and-adverbs",
         "title": "Comparatives and adverbs",
         "outcomes": [
          {
           "code": null,
           "text": "Use 比, 比较 and 最 for comparing."
          },
          {
           "code": null,
           "text": "Use 跟/和...一样 to state similarity."
          },
          {
           "code": null,
           "text": "Use adverbs 非常, 常常, 一定, 也, 还, 就."
          }
         ]
        }
       ]
      },
      {
       "id": "pronouns-and-verbs",
       "title": "Pronouns and verbs",
       "subtopics": [
        {
         "id": "pronouns",
         "title": "Pronouns",
         "outcomes": [
          {
           "code": null,
           "text": "Use personal pronouns, singular and plural, and with 的."
          },
          {
           "code": null,
           "text": "Use demonstratives 这 and 那, and 大家."
          }
         ]
        },
        {
         "id": "basic-verbs",
         "title": "Basic verbs",
         "outcomes": [
          {
           "code": null,
           "text": "Use 是 and 有, positive and negative."
          },
          {
           "code": null,
           "text": "Make simple sentences and verb-object verbs."
          },
          {
           "code": null,
           "text": "Use verbs of motion, transport and purpose."
          },
          {
           "code": null,
           "text": "Use modals 会, 想, 要, 应该, 可以 and 打算, 喜欢, 爱, 请."
          }
         ]
        },
        {
         "id": "aspect-and-complements",
         "title": "Aspect and complements",
         "outcomes": [
          {
           "code": null,
           "text": "Use 在 and 正在 for actions in progress."
          },
          {
           "code": null,
           "text": "Use 了 for completed actions and 过 for experience."
          },
          {
           "code": null,
           "text": "Use complements of direction, degree and manner."
          }
         ]
        }
       ]
      },
      {
       "id": "questions-location-and-prepositions",
       "title": "Questions, location and prepositions",
       "subtopics": [
        {
         "id": "questions",
         "title": "Questions",
         "outcomes": [
          {
           "code": null,
           "text": "Ask questions with 吗, choice questions and 还是."
          },
          {
           "code": null,
           "text": "Use question words such as 什么, 谁, 哪儿, 为什么, 怎么, 几, 多少."
          },
          {
           "code": null,
           "text": "Use tag questions with 呢 and 吧."
          }
         ]
        },
        {
         "id": "location-and-co-verbs",
         "title": "Location and co-verbs",
         "outcomes": [
          {
           "code": null,
           "text": "Use the co-verbs 从, 到, 在, 用, 坐."
          },
          {
           "code": null,
           "text": "Give location with 在 and 是 and positional phrases with 的."
          }
         ]
        }
       ]
      },
      {
       "id": "conjunctions-and-numbers",
       "title": "Conjunctions and numbers",
       "subtopics": [
        {
         "id": "conjunctions",
         "title": "Conjunctions",
         "outcomes": [
          {
           "code": null,
           "text": "Join nouns with 和 and say with using 和 or 跟; use 都."
          },
          {
           "code": null,
           "text": "Use paired conjunctions such as 虽然...但是, 因为...所以, 又...又."
          },
          {
           "code": null,
           "text": "Use 先...然后/再, 如果...就, 一边...一边 and 的时候."
          }
         ]
        },
        {
         "id": "numbers-time-and-quantity",
         "title": "Numbers, time and quantity",
         "outcomes": [
          {
           "code": null,
           "text": "Use numbers up to a million and ordinals with 第."
          },
          {
           "code": null,
           "text": "State quantities, prices, time and dates."
          },
          {
           "code": null,
           "text": "Give lengths of time and use time word order."
          }
         ]
        }
       ]
      }
     ]
