     "topics": [
      {
       "id": "nouns-and-articles",
       "title": "Nouns and articles",
       "subtopics": [
        {
         "id": "gender-of-nouns",
         "title": "Gender of nouns",
         "outcomes": [
          {
           "code": null,
           "text": "Know the gender of nouns and use gender endings."
          },
          {
           "code": null,
           "text": "Use diminutives and augmentatives like pãozinho and casarão."
          },
          {
           "code": null,
           "text": "Recognise nouns whose meaning changes with gender, like a caixa and o caixa."
          }
         ]
        },
        {
         "id": "plural-nouns",
         "title": "Plural nouns",
         "outcomes": [
          {
           "code": null,
           "text": "Form plurals of all nouns, including vowel changes such as ovos."
          },
          {
           "code": null,
           "text": "Form plurals of compound nouns and nouns with de."
          },
          {
           "code": null,
           "text": "Use plurals covering both genders, like os filhos."
          }
         ]
        },
        {
         "id": "articles",
         "title": "Articles",
         "outcomes": [
          {
           "code": null,
           "text": "Use definite and indefinite articles in agreement with the noun."
          },
          {
           "code": null,
           "text": "Use combined forms like ao, do, no and pelo."
          },
          {
           "code": null,
           "text": "Use the definite article with places, names and possessives."
          },
          {
           "code": null,
           "text": "Omit the indefinite article for origin, profession and religion."
          }
         ]
        }
