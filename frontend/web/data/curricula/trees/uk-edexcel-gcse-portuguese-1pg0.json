         "outcomes": [
          {
           "code": null,
           "text": "Use isto, isso and aquilo."
          },
          {
           "code": null,
           "text": "Use cada, tudo, nada, alguém and ninguém."
          },
          {
           "code": null,
           "text": "Use the relatives que, quem and onde."
