    {
     "id": "3-3-grammar",
     "title": "3.3 Grammar",
     "topics": [
      {
       "id": "3-3-1-foundation-tier-nouns-and-measure-words",
       "title": "3.3.1 Foundation Tier: Nouns and measure words",
       "subtopics": [
        {
         "id": "nouns-and-measure-words",
         "title": "Nouns and measure words",
         "outcomes": [
          {
           "code": "3.3.1.1",
           "text": "Form nouns with the suffixes 子, 家 and 员."
          },
          {
           "code": "3.3.1.2",
           "text": "Use the measure words 个, 岁, 年, 只, 天, 本 and 口."
          },
          {
           "code": null,
           "text": "Use 每 to mean 'every'."
          }
         ]
        }
       ]
      },
      {
       "id": "3-3-1-foundation-tier-adjectives-and-stative-ver",
       "title": "3.3.1 Foundation Tier: Adjectives and stative verbs",
       "subtopics": [
        {
         "id": "adjectives-as-predicates",
         "title": "Adjectives as predicates",
         "outcomes": [
          {
           "code": "3.3.1.3",
           "text": "Use adjectives or stative verbs as predicates, positive and negative."
          },
          {
           "code": null,
           "text": "Add modifiers 很 and 非常 to adjectives."
          },
          {
           "code": null,
           "text": "Modify nouns with or without 的."
          },
          {
           "code": null,
           "text": "Use 了 after an adjective to show a limit passed or a new situation."
          },
          {
           "code": null,
           "text": "Use stative verbs as adverbs, such as 好吃 and 难学."
          }
         ]
        }
       ]
      },
      {
       "id": "3-3-1-foundation-tier-exclamations",
       "title": "3.3.1 Foundation Tier: Exclamations",
       "subtopics": [
        {
         "id": "exclamations",
         "title": "Exclamations",
         "outcomes": [
          {
           "code": "3.3.1.4",
           "text": "Make exclamations with 太…了 and 真."
          }
         ]
        }
       ]
      },
      {
       "id": "3-3-1-foundation-tier-comparatives",
       "title": "3.3.1 Foundation Tier: Comparatives",
       "subtopics": [
        {
         "id": "comparing-things",
         "title": "Comparing things",
         "outcomes": [
          {
           "code": "3.3.1.5",
           "text": "Compare with 比, 比较 and 最."
          },
          {
           "code": null,
           "text": "State similarity with 跟/和…一样."
          }
         ]
        }
       ]
      },
      {
       "id": "3-3-1-foundation-tier-adverbs",
       "title": "3.3.1 Foundation Tier: Adverbs",
       "subtopics": [
        {
         "id": "common-adverbs",
         "title": "Common adverbs",
         "outcomes": [
          {
           "code": "3.3.1.6",
           "text": "Use the adverbs 非常, 常常, 一定, 也, 还 and 就."
          }
         ]
        }
       ]
      },
      {
       "id": "3-3-1-foundation-tier-pronouns",
       "title": "3.3.1 Foundation Tier: Pronouns",
       "subtopics": [
        {
         "id": "pronouns",
         "title": "Pronouns",
         "outcomes": [
          {
           "code": "3.3.1.7",
           "text": "Use all personal pronouns, singular and plural, with 的 for possession."
          },
          {
           "code": null,
           "text": "Use demonstratives 这 and 那, and 大家."
          }
         ]
        }
       ]
      },
      {
       "id": "3-3-1-foundation-tier-verbs",
       "title": "3.3.1 Foundation Tier: Verbs",
       "subtopics": [
        {
         "id": "basic-verbs",
         "title": "Basic verbs",
         "outcomes": [
          {
           "code": "3.3.1.8",
           "text": "Use 是 and 有, positive and negative."
          },
          {
           "code": null,
           "text": "Build simple verb-object sentences and verb-object verbs like 唱歌 and 跳舞."
          },
          {
           "code": null,
           "text": "Express motion, transport and purpose in coming and going."
          }
         ]
        },
        {
         "id": "modal-verbs-and-aspect",
         "title": "Modal verbs and aspect",
         "outcomes": [
          {
           "code": null,
           "text": "Use modal verbs 会, 想, 要, 应该 and 可以."
          },
          {
           "code": null,
           "text": "Express intention with 打算 and attitude with 喜欢 and 爱."
          },
          {
           "code": null,
           "text": "Show actions in progress with 在 and 正在."
          },
          {
           "code": null,
           "text": "Make requests with 请."
          },
          {
           "code": null,
           "text": "Show completed actions with 了 and experience with 过."
          },
          {
           "code": null,
           "text": "Use complements of direction, degree and manner."
          }
         ]
        }
       ]
      },
      {
       "id": "3-3-1-foundation-tier-prepositions-and-co-verbs",
       "title": "3.3.1 Foundation Tier: Prepositions and co-verbs",
       "subtopics": [
        {
         "id": "prepositions",
         "title": "Prepositions",
         "outcomes": [
          {
           "code": "3.3.1.9",
           "text": "Use the co-verbs 从, 到, 在, 用 and 坐."
          }
         ]
        }
       ]
      },
      {
       "id": "3-3-1-foundation-tier-interrogatives",
       "title": "3.3.1 Foundation Tier: Interrogatives",
       "subtopics": [
        {
         "id": "asking-questions",
         "title": "Asking questions",
         "outcomes": [
          {
           "code": "3.3.1.10",
           "text": "Ask yes/no questions with 吗 and choice questions with 还是."
          },
          {
           "code": null,
           "text": "Use question words such as 什么, 谁, 哪儿, 为什么, 怎么, 几, 多少 and 什么时候."
          },
          {
           "code": null,
           "text": "Form tag questions with 呢 and 吧."
          }
         ]
        }
       ]
      },
      {
       "id": "3-3-1-foundation-tier-location",
       "title": "3.3.1 Foundation Tier: Location",
       "subtopics": [
        {
         "id": "giving-location",
         "title": "Giving location",
         "outcomes": [
          {
           "code": "3.3.1.11",
           "text": "Give location with 在 and with 是."
          },
          {
           "code": null,
           "text": "Use positional phrases with 的, such as 墙上的画."
          }
         ]
        }
       ]
      },
      {
       "id": "3-3-1-foundation-tier-conjunctions",
       "title": "3.3.1 Foundation Tier: Conjunctions",
       "subtopics": [
        {
         "id": "joining-ideas",
         "title": "Joining ideas",
         "outcomes": [
          {
           "code": "3.3.1.12",
           "text": "Join nouns with 和, say 'with' using 和 or 跟, and use 都 for parallel subjects."
          },
          {
           "code": null,
           "text": "Link clauses with 虽然…但是, 因为…所以 and 如果/要是…就."
          },
          {
           "code": null,
           "text": "Link actions with 也…也, 又…又, 先…然后/再 and 一边…一边."
          },
          {
           "code": null,
           "text": "Use …的时候 for 'when'."
          }
         ]
        }
       ]
      },
      {
       "id": "3-3-1-foundation-tier-numbers-dates-and-time",
       "title": "3.3.1 Foundation Tier: Numbers, dates and time",
       "subtopics": [
        {
         "id": "numbers-dates-and-time",
         "title": "Numbers, dates and time",
         "outcomes": [
          {
           "code": "3.3.1.13",
           "text": "Use numbers up to a million and ordinals with 第."
          },
          {
           "code": null,
           "text": "State quantities, currency and prices."
          },
          {
           "code": null,
           "text": "Give time, date and length of time, with correct word order for time expressions."
          }
         ]
        }
       ]
      },
      {
       "id": "3-3-2-higher-tier-nouns-and-measure-words",
       "title": "3.3.2 Higher Tier: Nouns and measure words",
       "subtopics": [
        {
         "id": "nouns-and-measure-words",
         "title": "Nouns and measure words",
         "outcomes": [
          {
           "code": "3.3.2.1",
           "text": "Form nouns with the suffixes 儿 and 者."
          },
          {
           "code": "3.3.2.2",
           "text": "Use the measure words 条, 家, 次, 些, 杯 and 张."
          },
          {
           "code": null,
           "text": "Reduplicate measure words."
          }
         ]
        }
       ]
      },
      {
       "id": "3-3-2-higher-tier-adjectives-and-comparatives",
       "title": "3.3.2 Higher Tier: Adjectives and comparatives",
       "subtopics": [
        {
         "id": "adjectives-and-comparatives",
         "title": "Adjectives and comparatives",
         "outcomes": [
          {
           "code": "3.3.2.3",
           "text": "Intensify adjectives with 得多, 极了 and 不得了."
          },
          {
           "code": null,
           "text": "Combine adjective/stative verb with verb to make adjectives like 好吃 and 好看."
          },
          {
           "code": "3.3.2.4",
           "text": "Make comparative sentences that include quantities."
          }
         ]
        }
       ]
      },
      {
       "id": "3-3-2-higher-tier-adverbs-and-pronouns",
       "title": "3.3.2 Higher Tier: Adverbs and pronouns",
       "subtopics": [
        {
         "id": "adverbs-and-pronouns",
         "title": "Adverbs and pronouns",
         "outcomes": [
          {
           "code": "3.3.2.5",
           "text": "Use the adverbs 经常, 从来 and 从来不."
          },
          {
           "code": "3.3.2.6",
           "text": "Use the reflexive pronoun 自己."
          }
         ]
        }
       ]
      },
      {
       "id": "3-3-2-higher-tier-verbs",
       "title": "3.3.2 Higher Tier: Verbs",
       "subtopics": [
        {
         "id": "modals-and-future",
         "title": "Modals and future",
         "outcomes": [
          {
           "code": "3.3.2.7",
           "text": "Use modal verbs 得, 必须, 一定 and 能, and the negative 不用/不必."
          },
          {
           "code": null,
           "text": "Express intention with 准备 and imminent action with 了."
          }
         ]
        },
        {
         "id": "describing-and-directing-actions",
         "title": "Describing and directing actions",
         "outcomes": [
          {
           "code": null,
           "text": "Use 得 to describe how an action is carried out."
          },
          {
           "code": null,
           "text": "Use 给 and reduplicate verbs."
          },
          {
           "code": null,
           "text": "Form positive and negative imperatives."
          },
          {
           "code": null,
           "text": "Use resultative complements such as 看见 and 看不见."
          }
         ]
        },
        {
         "id": "sentence-patterns",
         "title": "Sentence patterns",
         "outcomes": [
          {
           "code": null,
           "text": "Report speech with 听说 and 妈妈说."
          },
          {
           "code": null,
           "text": "Build topic/comment sentences and use 是 plus a stative verb for emphasis."
          }
         ]
        }
       ]
      },
      {
       "id": "3-3-2-higher-tier-interrogatives-and-location",
       "title": "3.3.2 Higher Tier: Interrogatives and location",
       "subtopics": [
        {
         "id": "advanced-questions",
         "title": "Advanced questions",
         "outcomes": [
          {
           "code": "3.3.2.8",
           "text": "Use interrogatives 多远, 多长时间 and 多久."
          },
          {
           "code": null,
           "text": "Form indirect questions."
          },
          {
           "code": null,
           "text": "Use interrogatives for inclusiveness, exclusiveness and indefinite meaning."
          }
         ]
        },
        {
         "id": "distance-with",
         "title": "Distance with 离",
         "outcomes": [
          {
           "code": "3.3.2.9",
           "text": "Use 离 to state nearness or distance between two places."
          }
         ]
        }
       ]
      },
      {
       "id": "3-3-2-higher-tier-conjunctions",
       "title": "3.3.2 Higher Tier: Conjunctions",
       "subtopics": [
        {
         "id": "advanced-connectives",
         "title": "Advanced connectives",
         "outcomes": [
          {
           "code": "3.3.2.10",
           "text": "Say 'or' in statements with 或 and 或者."
          },
          {
           "code": null,
           "text": "Use 一…就, 不但…而且, 除了…以外 and 越…越."
          },
          {
           "code": null,
           "text": "Use connectives 而且, 不过, 那么, 因此 and 为了."
          }
         ]
        }
       ]
      }
     ]
