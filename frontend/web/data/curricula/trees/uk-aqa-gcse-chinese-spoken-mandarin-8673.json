    {
     "id": "3-4-vocabulary",
     "title": "3.4 Vocabulary",
     "topics": [
      {
       "id": "3-4-1-general-vocabulary",
       "title": "3.4.1 General vocabulary",
       "subtopics": [
        {
         "id": "measure-words",
         "title": "Measure words",
         "outcomes": [
          {
           "code": "3.4.1.1",
           "text": "Know the core measure words, such as 个, 本, 张, 只, 件 and 杯, and what they count."
          }
         ]
        },
        {
         "id": "verbs",
         "title": "Verbs",
         "outcomes": [
