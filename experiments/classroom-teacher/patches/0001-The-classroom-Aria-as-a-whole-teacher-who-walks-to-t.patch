+   "code": "export default function Animation({ sentence, sentenceProgress }) {\n  const ILLUSTRATION_ID = \"83112bfefa139f9e8e40d41ea69768be\";\n  /* BOARD_PICTURE {\"v\":1,\"id\":\"83112bfefa139f9e8e40d41ea69768be\",\"subject\":\"A textbook-style circulation diagram with a central four-chamber heart, lungs above it, body tissues surrounding it, and blue and red arrows forming pulmonary and systemic loops.\",\"paper\":\"#fffae8\",\"conceptId\":\"lab-b0\",\"title\":\"The two-circuit map\",\"parts\":[{\"name\":\"heart\",\"x\":0.5,\"y\":0.75},{\"name\":\"lungs\",\"x\":0.425,\"y\":0.225},{\"name\":\"body tissues\",\"x\":0.233,\"y\":0.5},{\"name\":\"right side\",\"x\":0.442,\"y\":0.6},{\"name\":\"left side\",\"x\":0.558,\"y\":0.6}],\"notes\":[\"right side \u2192 lungs\",\"lungs \u2192 left side\",\"left side \u2192 body\",\"body \u2192 right side\"],\"labels\":[],\"focus\":null,\"ink\":\"\"} BOARD_PICTURE */\n  const on = (k) => sentence >= k;\n  const reveal = (k) => ({ opacity: on(k) ? 1 : 0, y: on(k) ? 0 : 6 });\n  const draw = (k) => ({ pathLength: on(k) ? 1 : 0, opacity: on(k) ? 1 : 0 });\n  const thereAndBack = (t) => Math.sin(Math.PI * Math.max(0, Math.min(1, t)));\n  const REVEAL = { duration: 0.5, ease: \"easeOut\" };\n  const DRAW = { duration: 0.9, ease: \"easeInOut\" };\n  const POP = { type: \"spring\", stiffness: 260, damping: 18 };\n  const GLIDE = { duration: 0.35, ease: \"easeOut\" };\n  const picture = typeof BOARD_ILLUSTRATION === \"string\" ? BOARD_ILLUSTRATION : \"\";\n  const visualSpec = { subject: \"The two-circuit map\", recognitionCues: [\"a textbook illustration\"], requiredParts: [\"heart\",\"lungs\",\"body tissues\",\"right side\",\"left side\"], forbiddenShortcuts: [] };\n  const boardPlan = { composition: \"key notes left; illustration right\", readingPath: [\"right side \u2192 lungs\",\"lungs \u2192 left side\",\"left side \u2192 body\",\"body \u2192 right side\"], reservedRegions: [] };\n  return (\n    <svg viewBox=\"0 0 1000 560\" style={{ background: \"#fffae8\" }}>\n      <defs>\n        <clipPath id=\"board-picture-frame\">\n          <rect x=\"396.0\" y=\"124.0\" width=\"588.0\" height=\"392.0\" rx=\"18\" />\n        </clipPath>\n      </defs>\n      <rect x=\"0\" y=\"0\" width=\"1000\" height=\"560\" fill=\"#fffae8\" />\n      <motion.g initial={false} animate={reveal(0)} transition={REVEAL}>\n        <text x=\"56\" y=\"72\" fontSize=\"34\" fontWeight=\"800\" fill=\"#1b2440\">The two-circuit map</text>\n      </motion.g>\n      <g clipPath=\"url(#board-picture-frame)\">\n        <motion.g initial={false} animate={{ opacity: on(0) ? 1 : 0, scale: on(0) ? 1 : 0.97 }} transition={{ duration: 1.2, ease: [0.45, 0, 0.2, 1] }}>\n          <image href={picture} x=\"396.0\" y=\"124.0\" width=\"588.0\" height=\"392.0\" preserveAspectRatio=\"xMidYMid meet\" style={{ imageRendering: \"auto\" }} />\n        </motion.g>\n      </g>\n      <motion.g initial={false} animate={reveal(2)} transition={REVEAL}>\n        <motion.circle cx=\"63\" cy=\"221.4\" fill=\"#0ea5e9\"\n          initial={false} animate={{ r: sentence === 2 ? 7 : 5 }} transition={GLIDE} />\n        <text x=\"80\" y=\"229.0\" fontSize=\"23\" fontWeight=\"600\" fill=\"#1e293b\">right side \u2192 lungs</text>\n      </motion.g>\n      <motion.g initial={false} animate={reveal(2)} transition={REVEAL}>\n        <motion.circle cx=\"63\" cy=\"287.4\" fill=\"#f59e0b\"\n          initial={false} animate={{ r: sentence === 2 ? 7 : 5 }} transition={GLIDE} />\n        <text x=\"80\" y=\"295.0\" fontSize=\"23\" fontWeight=\"600\" fill=\"#1e293b\">lungs \u2192 left side</text>\n      </motion.g>\n      <motion.g initial={false} animate={reveal(3)} transition={REVEAL}>\n        <motion.circle cx=\"63\" cy=\"353.4\" fill=\"#10b981\"\n          initial={false} animate={{ r: sentence === 3 ? 7 : 5 }} transition={GLIDE} />\n        <text x=\"80\" y=\"361.0\" fontSize=\"23\" fontWeight=\"600\" fill=\"#1e293b\">left side \u2192 body</text>\n      </motion.g>\n      <motion.g initial={false} animate={reveal(3)} transition={REVEAL}>\n        <motion.circle cx=\"63\" cy=\"419.4\" fill=\"#e11d48\"\n          initial={false} animate={{ r: sentence === 3 ? 7 : 5 }} transition={GLIDE} />\n        <text x=\"80\" y=\"427.0\" fontSize=\"23\" fontWeight=\"600\" fill=\"#1e293b\">body \u2192 right side</text>\n      </motion.g>\n    </svg>\n  );\n}\n"
+  },
+  {
+   "id": "b1",
+   "title": "The four chambers and main vessels",
